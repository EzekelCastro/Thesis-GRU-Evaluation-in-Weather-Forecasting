.claudeignore — save in project root
# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
env/
.env/
.venv/

# Sensitive files
.env
*.key
*.pem

# Large output files (model weights, data dumps, plots)
*.csv
*.h5
*.pkl
*.pt
saved_models/
outputs/
plots/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
logs/